rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate alarm data
    function isValidAlarm() {
      let alarm = request.resource.data;
      return alarm.keys().hasAll(['userId', 'time', 'days', 'challenge', 'isEnabled'])
        && alarm.time is string
        && alarm.time.matches('^[0-2][0-9]:[0-5][0-9]$')
        && alarm.days is list
        && alarm.isEnabled is bool;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can only read/write their own document
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Validate user data on create/update
      allow write: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['uid', 'email', 'settings'])
        && request.resource.data.uid == userId;
    }
    
    // Alarms collection
    match /alarms/{alarmId} {
      // Users can only access their own alarms
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && isValidAlarm();
      
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // Analytics collection
    match /analytics/{eventId} {
      // Users can only write their own analytics
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Analytics should not be updated or deleted by users
      allow update, delete: if false;
    }
    
    // Sleep data collection
    match /sleepData/{dataId} {
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // QR codes collection
    match /qrCodes/{codeId} {
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // QR codes should not be updated
      allow update: if false;
    }
    
    // Subscriptions collection (managed by backend)
    match /subscriptions/{subId} {
      // Users can only read their own subscription
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Only backend can create/update/delete subscriptions
      allow create, update, delete: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
